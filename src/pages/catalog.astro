---
import { sanityClient } from '../lib/sanity';
import WheelCard from '../components/WheelCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { WHEELS_QUERY, type WheelData } from '../lib/queries';

const wheels = await sanityClient.fetch<WheelData[]>(WHEELS_QUERY);
---

<BaseLayout title="Catalog — G Boyz Wire Wheels" lang="en">
	<div class="page">
		<h1>Catalog</h1>
		{wheels.length > 0 ? (
			<div class="wheel-grid">
				{wheels.map((w) => <WheelCard wheel={w} />)}
			</div>
		) : (
			<p>No wheels in Sanity yet.</p>
		)}
	</div>
</BaseLayout>
