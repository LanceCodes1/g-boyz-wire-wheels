---
import { sanityClient } from '../../lib/sanity';
import WheelCard from '../../components/WheelCard.astro';
import SpokeDivider from '../../components/SpokeDivider.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WHEELS_QUERY, BUSINESS_INFO_QUERY, type WheelData, type BusinessInfo } from '../../lib/queries';

const allWheels = await sanityClient.fetch<WheelData[]>(WHEELS_QUERY);
const featuredWheels = allWheels.slice(0, 3);

const businessInfo = await sanityClient.fetch<BusinessInfo | null>(BUSINESS_INFO_QUERY);
const contact = businessInfo?.contact ?? {};

const contactHref = Astro.currentLocale === 'es' ? '/es/contact' : '/contact';
---

<BaseLayout title="G Boyz Wire Wheels" lang="es">
		<section class="hero">
			<h1>Ruedas de Alambre Personalizadas, Hechas a Pedido</h1>
			<p>Ruedas de alambre hechas a mano para clásicos, lowriders y autos personalizados — todos los estilos, todos los acabados.</p>
			<a href={contactHref} class="cta">Solicitar una Cotización</a>
		</section>

		<SpokeDivider />

		{featuredWheels.length > 0 && (
			<section class="featured-wheels page">
				<h2>Estilos Destacados</h2>
				<div class="wheel-grid">
					{featuredWheels.map((w) => <WheelCard wheel={w} />)}
				</div>
			</section>
		)}

		<SpokeDivider />

		<section class="about page">
			<h2>Sobre G Boyz Wire Wheels</h2>
			<p>
				G Boyz Wire Wheels comenzó con una idea simple — hacerlo bien, cada vez, y dejar
				que el trabajo hable por sí mismo. Inspirados por familiares ya en el oficio, los
				fundadores Madeline y Oscar construyeron el taller desde cero, basándose
				únicamente en su reputación, trabajo duro y recomendaciones de boca en boca — sin
				capital externo, solo artesanía que hacía regresar a los clientes. Veinticinco
				años después, ese mismo compromiso con la calidad sigue guiando cada rueda que
				sale del taller.
			</p>
		</section>

		<SpokeDivider />

		<section class="contact-strip page">
			{contact.phone && <p>{contact.phone}</p>}
			{contact.address && <p>{contact.address}</p>}
			<a href={contactHref}>Ver horario completo e información de contacto</a>
		</section>

		<p class="page"><a href="/">View in English</a></p>

		<style>
			.hero {
				width: 100%;
				text-align: center;
				padding: 6rem 1.5rem;
				background: radial-gradient(circle at 50% 30%, var(--color-surface) 0%, var(--color-bg) 70%);
			}

			.hero h1 {
				font-size: clamp(2rem, 5vw, 3.5rem);
				max-width: 720px;
				margin-left: auto;
				margin-right: auto;
			}

			.hero p {
				max-width: 520px;
				margin: 1rem auto 0;
				opacity: 0.85;
			}

			.cta {
				display: inline-block;
				margin-top: 1.75rem;
				padding: 0.75rem 2rem;
				background-color: var(--color-accent);
				color: var(--color-bg);
				font-family: var(--font-body);
				font-weight: 600;
				border-radius: 2px;
				transition: background-color 0.15s ease;
			}

			.cta:hover {
				background-color: var(--color-accent-alt);
				text-decoration: none;
			}

			.about p {
				max-width: 640px;
			}

			.contact-strip p {
				margin: 0.25rem 0;
			}
		</style>
</BaseLayout>
