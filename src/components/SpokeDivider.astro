---
---

<div class="spoke-divider" role="presentation" aria-hidden="true">
	<svg viewBox="0 0 400 48" preserveAspectRatio="none">
		<line x1="200" y1="24" x2="0" y2="0" />
		<line x1="200" y1="24" x2="0" y2="24" />
		<line x1="200" y1="24" x2="0" y2="48" />
		<line x1="200" y1="24" x2="80" y2="0" />
		<line x1="200" y1="24" x2="80" y2="48" />
		<line x1="200" y1="24" x2="320" y2="0" />
		<line x1="200" y1="24" x2="320" y2="48" />
		<line x1="200" y1="24" x2="400" y2="0" />
		<line x1="200" y1="24" x2="400" y2="24" />
		<line x1="200" y1="24" x2="400" y2="48" />
		<circle cx="200" cy="24" r="4" class="hub" />
	</svg>
</div>

<style>
	.spoke-divider {
		width: 100%;
		max-width: 480px;
		margin: 3rem auto;
		opacity: 0.7;
	}

	.spoke-divider svg {
		width: 100%;
		height: 48px;
		display: block;
	}

	.spoke-divider line {
		stroke: var(--color-border);
		stroke-width: 1;
	}

	.spoke-divider .hub {
		fill: var(--color-accent);
	}
</style>
