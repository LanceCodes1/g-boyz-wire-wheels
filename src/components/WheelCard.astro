---
import { urlFor } from '../lib/sanity';
import type { WheelData } from '../lib/queries';

interface Props {
  wheel: WheelData;
}

const { wheel } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const displayName = wheel.name[locale as 'en' | 'es'] || wheel.name.en;

const labels = {
  en: { quote: 'Request a Quote', startingAt: 'Starting at $', contactForPricing: 'Contact for pricing' },
  es: { quote: 'Solicitar una Cotización', startingAt: 'Desde $', contactForPricing: 'Contactar para precio' },
};
const t = labels[locale as 'en' | 'es'] ?? labels.en;

const contactHref = locale === 'es' ? '/es/contact' : '/contact';
---

<article>
  {wheel.images && wheel.images.length > 0 ? (
    <img src={urlFor(wheel.images[0]).width(400).url()} alt={displayName} />
  ) : (
    <div class="no-image">No image yet</div>
  )}

  <p class="style">{wheel.style}</p>
  <h3>{displayName}</h3>

  {wheel.availableFinishes && wheel.availableFinishes.length > 0 && (
    <p class="finishes">{wheel.availableFinishes.join(', ')}</p>
  )}

  {wheel.spokeCount && <p class="spoke-count">{wheel.spokeCount}-Spoke</p>}

  {wheel.quoteOnly ? (
    <a href={contactHref} class="quote-btn">{t.quote}</a>
  ) : wheel.priceRange?.min ? (
    <p class="price">{t.startingAt}{wheel.priceRange.min}</p>
  ) : (
    <p class="price">{t.contactForPricing}</p>
  )}
</article>

<style>
  article {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 1.25rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  article:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  img,
  .no-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 2px;
    background-color: var(--color-bg);
  }

  .no-image {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-border);
    font-size: 0.875rem;
  }

  .style {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-border);
    margin: 0.75rem 0 0.25rem;
  }

  h3 {
    font-size: 1.1rem;
    margin: 0 0 0.5rem;
  }

  .finishes {
    font-size: 0.875rem;
    opacity: 0.85;
    margin: 0.25rem 0;
  }

  .spoke-count,
  .price {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    margin: 0.25rem 0;
  }

  .quote-btn {
    display: inline-block;
    margin-top: 0.75rem;
    font-weight: 600;
  }
</style>
